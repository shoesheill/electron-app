@page
@model ticketApp.Pages.Asdf

@{
    Layout = "_Layout";
}

<form method="post">
    <div>
        <label asp-for="Theater.Title">Title</label>
        <input type="text" asp-for="Theater.Title" />
    </div>
    <div>
        <label asp-for="Theater.Address">Address</label>
        <input type="text" asp-for="Theater.Address" />
    </div>
    <div>
        <label asp-for="Theater.VatNo">VAT Number</label>
        <input type="text" asp-for="Theater.VatNo" />
    </div>
    <div>
        <label asp-for="Theater.IsVat">Is VAT Applicable?</label>
        <input type="checkbox" asp-for="Theater.IsVat" />
    </div>
    <div>
        <label asp-for="Theater.ThreeDCharge">3D Charge</label>
        <input type="number" asp-for="Theater.ThreeDCharge" />
    </div>
    <div>
        <label asp-for="Theater.FDF">Film Development Fee (FDF)</label>
        <input type="number" asp-for="Theater.FDF" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.LocalTax">Local Tax</label>
        <input type="number" asp-for="Theater.LocalTax" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.LocalTaxInternational">Local Tax (International)</label>
        <input type="number" asp-for="Theater.LocalTaxInternational" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.BoxOfficeTax">Box Office Tax</label>
        <input type="number" asp-for="Theater.BoxOfficeTax" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.EntertainmentTax">Entertainment Tax</label>
        <input type="number" asp-for="Theater.EntertainmentTax" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.ConvinienceCharge">Convenience Charge</label>
        <input type="number" asp-for="Theater.ConvinienceCharge" step="0.01" />
    </div>
    <div>
        <label asp-for="Theater.IsCCMS">Is CCMS Integrated?</label>
        <input type="checkbox" asp-for="Theater.IsCCMS" />
    </div>
    <div>
        <label asp-for="Theater.LogoPath">LogoPath</label>
        <input type="text" asp-for="Theater.LogoPath" />
    </div>
    <div>
        <label asp-for="Theater.QRCode">QRCode</label>
        <input type="checkbox" asp-for="Theater.QRCode" />
    </div>
    <div>
        <label asp-for="Theater.EnableTaxRegistration">EnableTaxRegistration</label>
        <input type="checkbox" asp-for="Theater.EnableTaxRegistration" />
    </div>
    <button type="submit">Save</button>
</form>

